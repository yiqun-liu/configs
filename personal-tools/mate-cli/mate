#!/usr/bin/env python3
"""mate — lightweight personal-assistant CLI backed by opencode.

One persistent global opencode session; each turn is a one-shot
`opencode run`. All state lives in ~/.local/state/mate.
"""

import datetime
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

OPENCODE_BIN = os.environ.get("OPENCODE_BIN", "opencode")
MATE_DIR = os.environ.get("MATE_DIR") or str(Path.home())
MATE_MODEL = os.environ.get("MATE_MODEL", "")
MATE_DEBUG = os.environ.get("MATE_DEBUG", "")
MATE_PORT = os.environ.get("MATE_PORT", "")
MATE_SERVER = os.environ.get("MATE_SERVER", "1").lower() not in ("0", "false", "no")
MATE_START_TIMEOUT = float(os.environ.get("MATE_START_TIMEOUT", "15"))
if "OPENCODE_CONFIG_DIR" not in os.environ:
    os.environ["OPENCODE_CONFIG_DIR"] = str(
        Path(os.path.realpath(__file__)).parent
    )
# Records the lazy server's port, or -1 after a failed boot (breaker marker).
# Spec path is /tmp/mate_server_port; fall back to the system temp dir only
# where /tmp does not exist (Windows).
_PORT_FILE_DEFAULT = "/tmp/mate_server_port" if Path("/tmp").is_dir() \
    else str(Path(tempfile.gettempdir()) / "mate_server_port")
PORT_FILE = Path(os.environ.get("MATE_PORT_FILE") or _PORT_FILE_DEFAULT)
STATE_DIR = Path(
    os.environ.get("MATE_STATE_DIR")
    or os.path.join(
        os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state"), "mate"
    )
)
SESSION_FILE = STATE_DIR / "session.id"

# The `do` executor: PowerShell on Windows (pwsh preferred, stock Windows
# PowerShell as fallback), plain bash elsewhere. MATE_SHELL overrides the
# binary (on Windows it must accept -Command, i.e. be a PowerShell).
if os.name == "nt":
    DO_SHELL = os.environ.get("MATE_SHELL") or shutil.which("pwsh") or "powershell"
else:
    DO_SHELL = os.environ.get("MATE_SHELL") or "bash"

FENCE_RE = re.compile(r"^```(bash|sh|shell|zsh|powershell|pwsh|ps1|ps)?[ \t]*$")

USAGE = """mate — personal assistant backed by opencode

usage:
  mate ask "question"        ask a question in the shared mate session
  mate do "task"             agent explains and proposes a shell command;
                              execute after confirmation
  mate lingo "text"          one-shot language help (word/grammar/rewrite)
  mate reset                 forget the session (next run starts fresh)
  mate stop                  dispose the lazily started opencode server

environment:
  MATE_MODEL   model override, passed as --model (e.g. "anthropic/claude-...")
  MATE_DIR     directory the global session lives in (default $HOME)
  MATE_DEBUG   if set, enables timestamped debug lines on stderr and
               copies the last turn's raw NDJSON to this path
  OPENCODE_BIN opencode binary (default "opencode")
  MATE_SHELL   shell that runs `do` commands (bash; pwsh/powershell on
               Windows)
  MATE_PORT    fixed port for the lazy server (default: auto-picked, recorded
               in /tmp/mate_server_port; -1 marks a failed boot and skips
               server use until `mate stop` clears it)
  MATE_SERVER  set 0 to force one-shot runs without a server
"""


# --- output styling -----------------------------------------------------------

RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
RED = "\033[31m"
GREEN = "\033[32m"
CYAN = "\033[36m"

USE_COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ
SECTION_WIDTH = (
    shutil.get_terminal_size(fallback=(44, 24)).columns if USE_COLOR else 44
)


def paint(text, *codes):
    if not USE_COLOR or not codes:
        return text
    return "".join(codes) + text + RESET


def print_section(title, *codes):
    """Print a full-width rule with an inline title: `─ title ─────`."""
    lead = f"─ {title} "
    rule = "─" * max(3, SECTION_WIDTH - len(lead))
    print(paint(lead + rule, *(codes or (BOLD,))))


def print_answer_marker(name):
    """TTY-only marker above an agent reply so it stands out from mate's own
    messages; omitted when piped to keep output clean."""
    if USE_COLOR:
        print_section(name, CYAN, BOLD)


def die(msg):
    err_color = sys.stderr.isatty() and "NO_COLOR" not in os.environ
    prefix = "\033[31m" if err_color else ""
    suffix = "\033[0m" if err_color else ""
    print(f"{prefix}mate: {msg}{suffix}", file=sys.stderr)
    sys.exit(1)


def debug(msg):
    """Timestamped, marked debug line to stderr; shown when MATE_DEBUG is set."""
    if not MATE_DEBUG:
        return
    stamp = datetime.datetime.now().isoformat(timespec="seconds")
    print(f"mate[debug] {stamp} {msg}", file=sys.stderr)


# --- session state -------------------------------------------------------------


def read_session_id():
    try:
        return SESSION_FILE.read_text().strip()
    except FileNotFoundError:
        return ""


def save_session_id(sid):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    SESSION_FILE.write_text(sid + "\n")


def reset_session():
    try:
        SESSION_FILE.unlink()
    except FileNotFoundError:
        pass


# --- transcript parsing ---------------------------------------------------------


def parse_ndjson(ndjson):
    """Parse newline-delimited JSON into a list of event dicts."""
    events = []
    for line in ndjson.splitlines():
        if not line.startswith("{"):
            continue
        try:
            events.append(json.loads(line))
        except json.JSONDecodeError:
            pass  # defensive: a "{"-prefixed line can be truncated mid-write
    return events


def extract_text(events):
    """Concatenate completed assistant text parts from event list, in order,
    deduplicated by part id (latest text overwrites, ordered by first
    appearance).

    Assumptions:
    1. there may be text-events with the same part IDs. last one wins.
    2. text-events with different part IDs are ordered by their first occurrence order.
    Part ids are opaque strings with not clear documentation.
    """
    texts = {}
    ordered_part_ids = []
    for event in events:
        if event.get("type") != "text":
            continue
        part = event.get("part") or {}
        if (part.get("time") or {}).get("end") is None:
            continue
        part_id = part.get("id")
        if part_id not in texts:
            ordered_part_ids.append(part_id)
        texts[part_id] = part.get("text", "")
    return "\n\n".join(texts[part_id] for part_id in ordered_part_ids)


def split_do_cmd_reply(reply):
    """Split a reply into (prose, command) around the first fenced block."""
    prose_lines, cmd_lines = [], []
    fence = 0
    for line in reply.splitlines():
        if fence < 2 and FENCE_RE.match(line):
            fence += 1
            if fence == 2:
                break
            continue
        if fence == 1:
            cmd_lines.append(line)
        else:
            prose_lines.append(line)
    return "\n".join(prose_lines).strip(), "\n".join(cmd_lines)


def extract_first_session_id(events):
    for event in events:
        if event.get("sessionID") is not None:
            return event["sessionID"]
    return ""


def extract_first_error(events):
    for event in events:
        if event.get("type") == "error":
            err = event.get("error") or {}
            msg = (err.get("data") or {}).get("message") or err.get("message") or str(err)
            return msg
    return ""


# --- lazy backend ---------------------------------------------------------------


def read_port_file():
    """Port recorded by a previous run, -1 failure marker, or None."""
    try:
        return int(PORT_FILE.read_text().strip())
    except FileNotFoundError:
        return None  # expected on first run
    except (ValueError, OSError):
        return None  # defensive: mate writes only ints here, but the file
        # can be corrupted or replaced


def write_port_file(value):
    try:
        PORT_FILE.write_text(f"{value}\n")
    except OSError:
        pass  # defensive: a full or read-only temp dir; mate still runs,
        # only the port record is lost


def configured_port():
    if not MATE_PORT:
        return None
    try:
        return int(MATE_PORT)
    except ValueError:
        die(f"invalid MATE_PORT: {MATE_PORT}")


def pick_free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def server_url(port):
    return f"http://127.0.0.1:{port}"


def server_healthy(port):
    try:
        with urllib.request.urlopen(f"{server_url(port)}/global/health", timeout=2) as resp:
            return resp.status == 200
    except Exception:
        return False


def ensure_server():
    """Port of an opencode server to connect to, or None for one-shot runs.

    The port in use (or -1 after a failed boot) persists in the port file,
    so later invocations reuse the server or skip booting entirely.
    MATE_SERVER=0 disables the lazy server; `mate stop` clears the file.

    Runs connect with `--port`: like `--attach` it targets the running
    server, but it also streams the full assistant event set.
    """
    if not MATE_SERVER:
        return None
    recorded = read_port_file()
    if recorded == -1:
        return None
    port = configured_port() or recorded or pick_free_port()

    if server_healthy(port):
        return port
    try:
        popen = dict(
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if os.name == "nt":
            popen["creationflags"] = 0x00000008 | 0x00000200  # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
        else:
            popen["start_new_session"] = True
        subprocess.Popen(
            [OPENCODE_BIN, "serve", "--hostname", "127.0.0.1", "--port", str(port)],
            **popen,
        )
    except FileNotFoundError:
        die("opencode not found in PATH (set OPENCODE_BIN?)")
    deadline = time.monotonic() + MATE_START_TIMEOUT
    while time.monotonic() < deadline:
        time.sleep(0.25)
        if server_healthy(port):
            write_port_file(port)
            return port
    write_port_file(-1)
    print(
        f"mate: server did not come up on :{port}; falling back to one-shot runs",
        file=sys.stderr,
    )
    return None


def cmd_stop():
    port = configured_port() or read_port_file()
    if port and port != -1 and server_healthy(port):
        try:
            req = urllib.request.Request(f"{server_url(port)}/instance/dispose", method="POST")
            with urllib.request.urlopen(req, timeout=2):
                pass
        except Exception as exc:
            die(f"could not dispose server: {exc}")
        print(paint(f"mate: disposed server on :{port}", DIM))
    else:
        print(paint("mate: no server running", DIM))
    # Clear the port (or -1 marker) so the next run boots fresh.
    try:
        PORT_FILE.unlink()
    except FileNotFoundError:
        pass


# --- opencode invocation --------------------------------------------------------


def run_turn(prompt, agent="mate", persist=True):
    """Send one turn to the given agent; print the assistant text. With
    persist=True the turn runs in the shared session (a stored session id
    that no longer exists is dropped and the turn retried once fresh).
    With persist=False the turn is one-shot: session state is neither read
    nor written."""
    attempts = (1, 2) if persist else (1,)
    for _attempt in attempts:
        call = [OPENCODE_BIN, "run", "--format", "json", "--agent", agent, "--dir", MATE_DIR]
        if MATE_MODEL:
            call += ["--model", MATE_MODEL]
        sid = read_session_id() if persist else ""
        if sid:
            call += ["--session", sid]
        else:
            call += ["--title", agent]
        attach = ensure_server()
        if attach:
            call += ["--port", str(attach)]

        try:
            debug(f"exec: {shlex.join(call + [prompt])}")
            # Decode as UTF-8 explicitly: opencode always emits UTF-8, and
            # text=True alone would use the locale codec, crashing or
            # mangling the JSON under a non-UTF-8 locale.
            proc = subprocess.run(
                call + [prompt],
                stdin=subprocess.DEVNULL,
                capture_output=True,
                text=True,
                encoding="utf-8",
                errors="replace",
            )
        except FileNotFoundError:
            die("opencode not found in PATH (set OPENCODE_BIN?)")

        ndjson = "\n".join(line for line in proc.stdout.splitlines() if line.startswith("{"))
        events = parse_ndjson(ndjson)
        if MATE_DEBUG:
            Path(MATE_DEBUG).write_text(ndjson)
            debug(f"dumped {len(events)} NDJSON events to {MATE_DEBUG}")

        new_sid = extract_first_session_id(events)
        if new_sid:
            text = extract_text(events)
            err = extract_first_error(events)
            if not text and err:
                # The turn failed upstream (provider/proxy error); never
                # report an empty reply as success.
                die(f"opencode error: {err}")
            if persist and new_sid != sid:
                save_session_id(new_sid)
            return text

        # No sessionID in output: the stored session is gone or the run failed.
        if persist and sid:
            print("mate: stored session not found, starting a new one", file=sys.stderr)
            reset_session()
            continue
        die("opencode run produced no output")
    # Defensive; unreachable: every loop pass returns text or dies, and the
    # retry path (persist attempt 1) always terminates on the second pass.
    die("opencode run failed twice")


# --- subcommands ------------------------------------------------------------------


def cmd_ask(question):
    print_answer_marker("mate")
    print(run_turn(f"[ASK] {question}"))


def cmd_lingo(args):
    all_args = " ".join(args)

    consume_tty_stdin = all_args == '-'
    consume_redirect_stdin = not all_args and not sys.stdin.isatty()
    if consume_tty_stdin or consume_redirect_stdin:
        all_args = sys.stdin.read().strip()
    if not all_args:
        die('usage: mate lingo "text" (or pipe text: mate lingo -)')
    print_answer_marker("lingo")
    print(run_turn(all_args, agent="lingo", persist=False))


def cmd_do(task):
    tagged = f"[DO] {task}"
    while True:
        prose, cmd = split_do_cmd_reply(run_turn(tagged))
        if not cmd and prose.strip().startswith("ABORT"):
            print(paint(prose.strip(), RED), file=sys.stderr)
            sys.exit(1)
        if not cmd:
            print(paint("mate: reply contained no fenced command block:", RED), file=sys.stderr)
            print(prose, file=sys.stderr)
            try:
                resp = input(paint("rework feedback (Ctrl-C to abort): ", DIM))
            except EOFError:
                die("aborted")
            tagged = f"[REWORK] Your previous reply had no command block. {resp}"
            continue
        if prose:
            print_section("explanation")
            print(prose + "\n")
        print_section("command")
        print(cmd + "\n")
        try:
            resp = input(paint("execute? [Y=yes | rework: <feedback> | other=abort] ", DIM))
        except EOFError:
            die("aborted")
        if resp.lower() in ("y", "yes"):
            break
        if resp.startswith("rework:"):
            tagged = f"[REWORK] {resp[len('rework:'):].lstrip()}"
            continue
        die("aborted")

    try:
        # Capture to a file, not a pipe: subprocess.run with stdout=PIPE
        # waits for EOF, so a backgrounded child inheriting the pipe fd
        # would hang mate forever. A file is drained only by us after the
        # shell exits; stray children writing to it are harmless.
        with tempfile.TemporaryFile(mode="w+", encoding="utf-8", errors="replace") as out_f:
            if os.name == "nt":
                # Exit with the last native command's status ($LASTEXITCODE)
                # when nonzero, else 1 when the statement failed ($? false):
                # failing cmdlets never set $LASTEXITCODE, so a bare
                # `exit $LASTEXITCODE` would report success. $ok captures $?
                # before the if-statement resets it (PS 5.1 and pwsh).
                status = (
                    "$ok = $?; "
                    "if ($LASTEXITCODE) { exit $LASTEXITCODE } "
                    "elseif (-not $ok) { exit 1 } else { exit 0 }"
                )
                argv = [DO_SHELL, "-Command", cmd + "\n" + status]
            else:
                argv = [DO_SHELL, "-c", cmd]
            proc = subprocess.run(
                argv,
                stdin=subprocess.DEVNULL,
                stdout=out_f,
                stderr=subprocess.STDOUT,
            )
            out_f.flush()
            out_f.seek(0)
            out = out_f.read()
    except FileNotFoundError:
        die(f"{DO_SHELL} not found for execution (set MATE_SHELL?)")
    out = out.rstrip("\n")

    print_section("output")
    if out:
        print(out)
    print_section(f"exit {proc.returncode}", GREEN if proc.returncode == 0 else RED)

    # Feed the outcome back so the assistant can self-correct on the next turn.
    ack = run_turn(f"[RESULT] exit={proc.returncode}; last output (tail): {out[-500:]}")
    if ack:
        print(paint(f"mate: {ack.splitlines()[0]}", DIM))
    sys.exit(proc.returncode)


# --- dispatch -----------------------------------------------------------------------


def main(argv):
    subcmd = argv[0] if argv else ""
    if subcmd in ("ask", "do"):
        if len(argv) < 2:
            noun = "question" if subcmd == "ask" else "task"
            die(f'usage: mate {subcmd} "{noun}"')
        arg = " ".join(argv[1:])
        if subcmd == "ask":
            cmd_ask(arg)
        else:
            cmd_do(arg)
    elif subcmd == "lingo":
        cmd_lingo(argv[1:])
    elif subcmd == "reset":
        reset_session()
        print(paint("mate: session state cleared", DIM))
    elif subcmd == "stop":
        cmd_stop()
    elif subcmd in ("-h", "--help", "help", ""):
        print(USAGE)
    else:
        die(f"unknown subcommand: {subcmd} (try: mate help)")
    return 0


if __name__ == "__main__":
    # Keep the unicode banners printable on legacy Windows code pages.
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(errors="replace")
        except Exception:
            pass  # defensive: a replaced stdout/stderr may lack reconfigure
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print("mate: aborted", file=sys.stderr)
        sys.exit(130)
